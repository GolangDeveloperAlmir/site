{
  "name": "site",
  "version": "1.0.0",
  "description": "Almir Personal Site Structure",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "yarn lint && yarn type-check && yarn test && yarn build",
    "postinstall": "simple-git-hooks",
    "token:generate": "bash scripts/generate-gh-token.sh",
    "token:check": "bash scripts/check-gh-token.sh",
    "branch:protect": "bash scripts/apply-branch-rules.sh"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "lucide-react": "^0.544.0",
    "next": "^15.5.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "lucide-react": "^0.546.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.6",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.7.3",
    "vitest": "^4.0.4"
  },
  "simple-git-hooks": {
    "pre-push": "yarn verify"
  }
}
