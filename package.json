{
  "name": "site",
  "version": "1.0.0",
  "description": "Almir Personal Site Structure",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "yarn build && playwright test",
    "e2e:headed": "yarn build && playwright test --headed",
    "audit": "yarn audit || true",
    "token:generate": "bash scripts/generate-gh-token.sh",
    "token:check": "bash scripts/check-gh-token.sh",
    "branch:protect": "bash scripts/apply-branch-rules.sh"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@grafana/faro-web-sdk": "^1.11.0",
    "@grafana/faro-web-tracing": "^1.11.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.207.0",
    "@opentelemetry/instrumentation-document-load": "^0.53.0",
    "@opentelemetry/instrumentation-fetch": "^0.207.0",
    "@opentelemetry/sdk-trace-web": "^2.2.0",
    "lucide-react": "^0.545.0",
    "next": "^15.5.3",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^24.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^9.13.0",
    "eslint-config-next": "^15.5.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.9.2",
    "vitest": "^2.1.4"
  }
}
